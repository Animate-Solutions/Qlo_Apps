<div class="pulse-inv">{if $sheet}<div class="panel"><h3>Count {$sheet.count_no} — {$sheet.store} <span class="label label-info">{$sheet.status}</span> <a class="btn btn-default btn-sm pull-right" href="{$self_url}">Back</a> <a class="btn btn-default btn-sm pull-right" href="javascript:window.print()">Print sheet</a></h3>
<form method="post"><input type="hidden" name="id_count" value="{$sheet.id_pulse_inv_count}"><table class="table table-condensed"><thead><tr><th>SKU</th><th>Item</th><th>Unit</th><th class="text-right">System</th><th>Counted</th><th class="text-right">Variance</th><th class="text-right">Value</th></tr></thead><tbody>{foreach $sheet.lines as $l}<tr class="{if $l.counted_qty!==null && $l.variance!=0}warning{/if}"><td>{$l.sku}</td><td>{$l.name}</td><td>{$l.unit}</td><td class="text-right">{if $sheet.status=='open'}<span class="noprint">{$l.system_qty}</span>{else}{$l.system_qty}{/if}</td><td>{if $sheet.status!='posted'}<input name="counted[{$l.id_pulse_inv_count_line}]" class="input-xs" value="{$l.counted_qty}" style="width:80px">{else}{$l.counted_qty}{/if}</td><td class="text-right">{if $l.counted_qty!==null}{$l.variance}{/if}</td><td class="text-right">{if $l.counted_qty!==null}{$l.variance_value}{/if}</td></tr>{/foreach}</tbody></table>
{if $sheet.status!='posted' && $sheet.status!='cancelled'}<button name="enterCount" class="btn btn-default">Save counts</button> <button name="postCount" class="btn btn-primary" onclick="return confirm('Post variances as adjustments?')">Post count</button> <button name="cancelCount" class="btn btn-link">Cancel count</button>{/if}</form><p class="help-block">Blind counting: print the sheet before entering figures — the system quantity column is hidden on the printout while the count is open.</p></div>{/if}
<div class="panel"><h3><i class="icon-check"></i> Stock counts</h3><table class="table table-condensed"><thead><tr><th>No</th><th>Store</th><th>Type</th><th>Status</th><th>Variance value</th><th>Counted by</th><th>Opened</th><th>Posted</th></tr></thead><tbody>{foreach $counts as $c}<tr><td><a href="{$self_url}&id_count={$c.id_pulse_inv_count}">{$c.count_no}</a></td><td>{$c.store}</td><td>{$c.type}</td><td>{$c.status}</td><td>{$c.variance_value}</td><td>{$c.who}</td><td>{$c.date_add}</td><td>{$c.date_posted}</td></tr>{/foreach}</tbody></table>
<form method="post" class="form-inline"><select name="id_store" class="form-control">{foreach $stores as $s}<option value="{$s.id_pulse_inv_store}">{$s.name}</option>{/foreach}</select> <select name="ctype" class="form-control"><option value="full">Full count</option><option value="cycle">Cycle count (choose items)</option><option value="spot">Spot check</option></select> <select name="cycle_items[]" multiple class="form-control" style="height:80px">{foreach $items as $i}<option value="{$i.id_pulse_inv_item}">{$i.name}</option>{/foreach}</select> <input name="cnote" class="form-control" placeholder="Note"> <button name="openCount" class="btn btn-default">Open count</button></form></div></div>
