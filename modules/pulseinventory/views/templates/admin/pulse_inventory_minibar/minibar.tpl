<div class="pulse-inv"><div class="row"><div class="col-md-6"><div class="panel"><h3><i class="icon-glass"></i> Post minibar consumption</h3>{if !$fd}<p class="text-warning">Front Desk not installed — stock is deducted but nothing is charged to a folio.</p>{/if}
<form method="post" class="form-horizontal"><div class="form-group"><label class="col-sm-3">Room</label><div class="col-sm-9"><select name="id_room" class="form-control">{foreach $rooms as $r}<option value="{$r.id_room}">{$r.room_num}{if $r.guest} — {$r.guest}{else} (vacant){/if}</option>{/foreach}</select></div></div>
<table class="table table-condensed"><thead><tr><th>Item</th><th>Par</th><th>Price</th><th>Consumed</th></tr></thead><tbody>{foreach $par as $p}<tr><td>{$p.name}</td><td>{$p.par}</td><td>{$cur}{$p.sale_price|number_format:0}</td><td><input name="mb_qty[{$p.id_pulse_inv_item}]" class="input-xs" style="width:60px" placeholder="0"></td></tr>{/foreach}</tbody></table><label><input type="checkbox" name="complimentary" value="1"> Complimentary (no charge)</label> <button name="postMinibar" class="btn btn-primary pull-right">Post to folio &amp; stock</button></form></div>
<div class="panel"><h3>Minibar par list</h3><table class="table table-condensed"><tbody>{foreach $par as $p}<tr><td>{$p.name}</td><td>par {$p.par}</td><td>{$cur}{$p.sale_price|number_format:0}</td><td>cost {$p.avg_cost|number_format:0}</td><td><form method="post" class="inline"><input type="hidden" name="mb_item_r" value="{$p.id_pulse_inv_item}"><button name="removeParItem" class="btn btn-xs btn-link">remove</button></form></td></tr>{/foreach}</tbody></table><form method="post" class="form-inline"><select name="mb_item" class="form-control">{foreach $items as $i}<option value="{$i.id_pulse_inv_item}">{$i.name}</option>{/foreach}</select> <select name="mb_type" class="form-control"><option value="">all room types</option>{foreach $room_types as $t}<option value="{$t.id_product}">{$t.name}</option>{/foreach}</select> par <input name="mb_par" class="form-control" value="2" style="width:60px"> price <input name="mb_price" class="form-control" style="width:90px"> <input name="mb_sort" class="form-control" placeholder="sort" style="width:60px"> <button name="saveParItem" class="btn btn-default btn-sm">Save</button></form></div>
<div class="panel"><h3>Refill minibar stock from central store</h3><form method="post"><table class="table table-condensed"><thead><tr><th>Item</th><th>Minibar store</th><th>Central</th><th>Used 7d</th><th>Par total</th><th>Refill qty</th></tr></thead><tbody>{foreach $refill as $r}<tr class="{if $r.minibar_qty<$r.par_total}warning{/if}"><td>{$r.name}</td><td>{$r.minibar_qty}</td><td>{$r.main_qty}</td><td>{$r.used_7d}</td><td>{$r.par_total}</td><td><input name="rf_qty[{$r.id_pulse_inv_item}]" class="input-xs" style="width:70px" placeholder="{if $r.par_total>$r.minibar_qty}{($r.par_total-$r.minibar_qty)|round}{/if}"></td></tr>{/foreach}</tbody></table><button name="refill" class="btn btn-default">Transfer to minibar stock</button></form></div></div>
<div class="col-md-6"><div class="panel"><h3>Recent minibar postings</h3><table class="table table-condensed"><tbody>{foreach $posts as $p}<tr><td>{$p.date_add|date_format:"%d/%m %H:%M"}</td><td>Rm {$p.room_num}</td><td><small>{$p.lines|truncate:60}</small></td><td class="text-right">{$cur}{$p.total|number_format:0}</td><td>{if $p.complimentary}comp{elseif $p.folio_line}charged{else}stock only{/if}</td><td>{$p.who}</td></tr>{/foreach}</tbody></table>
<h4>Consumption {$from} → {$to}</h4><form method="get" class="form-inline"><input type="hidden" name="controller" value="AdminPulseInventoryMinibar"><input type="hidden" name="token" value="{$smarty.get.token|escape}"><input type="date" name="from" value="{$from}" class="form-control input-sm"> <input type="date" name="to" value="{$to}" class="form-control input-sm"> <button class="btn btn-sm btn-default">Run</button></form><table class="table table-condensed"><thead><tr><th>Item</th><th>Qty</th><th>Comp</th><th class="text-right">Cost</th><th class="text-right">Revenue</th></tr></thead><tbody>{foreach $consumption as $c}<tr><td>{$c.name}</td><td>{$c.qty}</td><td>{$c.comp_qty}</td><td class="text-right">{$c.cost|number_format:0}</td><td class="text-right">{$c.revenue|number_format:0}</td></tr>{/foreach}</tbody></table></div>
<div class="panel"><h3><i class="icon-gift"></i> Guest amenities (housekeeping)</h3><table class="table table-condensed"><thead><tr><th>Amenity</th><th>Par / room</th><th>When</th><th>HK store qty</th><th></th></tr></thead><tbody>{foreach $amenities as $a}<tr class="{if $a.hk_qty<=0}danger{/if}"><td>{$a.name}</td><td>{$a.par_per_room} {$a.unit}</td><td>{$a.frequency|replace:'_':' '}</td><td>{$a.hk_qty}</td><td><form method="post" class="inline"><input type="hidden" name="am_item_r" value="{$a.id_pulse_inv_item}"><button name="removeAmenity" class="btn btn-xs btn-link">remove</button></form></td></tr>{/foreach}</tbody></table>
<form method="post" class="form-inline"><select name="am_item" class="form-control">{foreach $items as $i}<option value="{$i.id_pulse_inv_item}">{$i.name}</option>{/foreach}</select> <select name="am_type" class="form-control"><option value="">all room types</option>{foreach $room_types as $t}<option value="{$t.id_product}">{$t.name}</option>{/foreach}</select> par <input name="am_par" class="form-control" value="1" style="width:60px"> <select name="am_freq" class="form-control"><option value="daily">daily (per occupied room)</option><option value="arrival">on arrival</option><option value="on_request">on request only</option></select> <button name="saveAmenity" class="btn btn-default btn-sm">Save</button></form>
<form method="post" class="form-inline" style="margin-top:6px"><input type="date" name="am_date" class="form-control input-sm"> <button name="postAmenities" class="btn btn-default btn-sm">Post standard consumption for date</button> <small>(night audit does this automatically)</small></form>
<h4>Cost per occupied room {$from} → {$to} ({$cpor.occupied_room_nights} room nights)</h4><table class="table table-condensed"><tbody>{foreach $cpor.rows as $r}<tr><td>{$r.group_name|replace:'_':' '}</td><td class="text-right">{$cur}{$r.cost|number_format:0}</td><td class="text-right">{if $r.per_occupied_room!==null}{$cur}{$r.per_occupied_room|number_format:0} / room{/if}</td></tr>{/foreach}</tbody></table></div></div></div></div>
