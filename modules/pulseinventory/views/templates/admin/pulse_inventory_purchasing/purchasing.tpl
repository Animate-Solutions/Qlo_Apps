<div class="pulse-inv">
{if isset($req)}<div class="panel"><h3>Requisition {$req.req_no} <span class="label label-info">{$req.status|replace:'_':' '}</span> <small>{$req.type|replace:'_':' '} · {if $req.from_store}{$req.from_store} → {$req.to_store}{/if} · {$req.department} · needed {$req.needed_by}</small> <a class="btn btn-default btn-sm pull-right" href="{$self_url}">Back</a></h3><p>{$req.note}</p>
<form method="post"><input type="hidden" name="id_request" value="{$req.id_pulse_inv_request}"><table class="table table-condensed"><thead><tr><th>Item</th><th>Requested</th><th>Approved</th><th>Issued</th>{if $req.type=='store_issue'}<th>Available in {$req.from_store}</th><th>Issue now</th>{/if}</tr></thead><tbody>{foreach $req_lines as $l}<tr class="{if $req.type=='store_issue' && $l.available<$l.qty_requested}warning{/if}"><td>{$l.sku} {$l.name}</td><td>{$l.qty_requested} {$l.unit}</td><td>{if $req.status=='submitted'}<input name="approved[{$l.id_pulse_inv_request_line}]" class="input-xs" value="{$l.qty_requested}" style="width:70px">{else}{$l.qty_approved}{/if}</td><td>{$l.qty_issued}</td>{if $req.type=='store_issue'}<td>{$l.available}</td><td>{if $req.status!='issued' && $req.status!='rejected'}<input name="issued[{$l.id_pulse_inv_request_line}]" class="input-xs" placeholder="qty" style="width:70px">{/if}</td>{/if}</tr>{/foreach}</tbody></table>
{if $req.status=='submitted'}<button name="approveRequest" class="btn btn-success">Approve</button> <button name="approveRequest" value="1" class="btn btn-danger" formaction="{$self_url}&reject=1">Reject</button>{/if} {if $req.type=='store_issue' && in_array($req.status, ['submitted','approved','partially_issued'])}<button name="issueRequest" class="btn btn-primary">Issue (blank = approved qty)</button>{/if} {if $req.type=='purchase' && $req.status=='approved'}<a class="btn btn-default" href="#po">Create PO from this requisition below</a>{/if}</form></div>{/if}
{if isset($po)}<div class="panel"><h3>Purchase order {$po.po_no} <span class="label label-info">{$po.status|replace:'_':' '}</span> <small>{$po.supplier} · expected {$po.expected_date}</small> <a class="btn btn-default btn-sm pull-right" href="{$self_url}">Back</a> <a class="btn btn-default btn-sm pull-right" href="javascript:window.print()">Print</a></h3>
<table class="table table-condensed"><thead><tr><th>Item</th><th>Ordered</th><th>Unit price</th><th>Tax %</th><th>Received</th><th class="text-right">Line total</th></tr></thead><tbody>{foreach $po.lines as $l}<tr><td>{$l.sku} {$l.name}</td><td>{$l.qty_ordered} {$l.purchase_unit|default:$l.unit}</td><td>{$l.unit_price}</td><td>{$l.tax_pct}</td><td>{$l.qty_received}</td><td class="text-right">{($l.qty_ordered*$l.unit_price)|number_format:2}</td></tr>{/foreach}<tr><th colspan="5" class="text-right">Total incl. tax</th><th class="text-right">{$cur}{$po.total|number_format:2}</th></tr></tbody></table>
<form method="post" class="form-inline noprint"><input type="hidden" name="id_po" value="{$po.id_pulse_inv_po}">{if $po.status=='draft'}<button name="poStatus" class="btn btn-primary" formaction="{$self_url}&status=sent">Approve &amp; send to supplier{if $po.total>$approval_limit} (SuperAdmin){/if}</button>{/if} {if in_array($po.status,['sent','partially_received'])}<a class="btn btn-success" href="#grn">Receive goods below</a>{/if} {if $po.status!='closed' && $po.status!='cancelled'}<button name="poStatus" class="btn btn-default" formaction="{$self_url}&status=closed">Close</button> <button name="poStatus" class="btn btn-link" formaction="{$self_url}&status=cancelled" onclick="return confirm('Cancel PO?')">Cancel</button>{/if}</form></div>{/if}
<div class="row"><div class="col-md-6"><div class="panel"><h3>Requisitions</h3><table class="table table-condensed"><thead><tr><th>No</th><th>Type</th><th>Stores</th><th>Dept</th><th>Lines</th><th>Status</th><th>By</th></tr></thead><tbody>{foreach $requests as $r}<tr class="{if $r.status=='submitted'}warning{/if}"><td><a href="{$self_url}&id_request={$r.id_pulse_inv_request}">{$r.req_no}</a></td><td>{$r.type|replace:'_':' '}</td><td>{$r.from_store} → {$r.to_store}</td><td>{$r.department}</td><td>{$r.lines}</td><td>{$r.status|replace:'_':' '}</td><td>{$r.who}</td></tr>{/foreach}</tbody></table>
<h4>New requisition</h4><form method="post"><div class="form-inline"><select name="rtype" class="form-control"><option value="store_issue">Store issue (transfer)</option><option value="purchase">Purchase request</option></select> <select name="from_store" class="form-control">{foreach $stores as $s}<option value="{$s.id_pulse_inv_store}" {if $s.code=='MAIN'}selected{/if}>from {$s.code}</option>{/foreach}</select> <select name="to_store" class="form-control">{foreach $stores as $s}<option value="{$s.id_pulse_inv_store}">to {$s.code}</option>{/foreach}</select> <select name="department" class="form-control">{foreach ['fnb','housekeeping','rooms','admin','maintenance','laundry','general'] as $d}<option>{$d}</option>{/foreach}</select> <input type="date" name="needed_by" class="form-control"> <input name="rnote" class="form-control" placeholder="Note"></div><table class="table table-condensed">{section name=n loop=6}<tr><td><select name="r_id[]" class="form-control input-sm"><option value="">—</option>{foreach $items as $i}<option value="{$i.id_pulse_inv_item}">{$i.name} ({$i.unit})</option>{/foreach}</select></td><td><input name="r_qty[]" class="form-control input-sm" placeholder="qty"></td></tr>{/section}</table><button name="createRequest" class="btn btn-default">Submit requisition</button> <button name="autoPr" class="btn btn-default">Auto purchase request from reorder levels ({$reorder|count})</button></form></div></div>
<div class="col-md-6"><div class="panel" id="po"><h3>Purchase orders</h3><table class="table table-condensed"><thead><tr><th>PO</th><th>Supplier</th><th>Total</th><th>Expected</th><th>Status</th></tr></thead><tbody>{foreach $pos as $p}<tr><td><a href="{$self_url}&id_po={$p.id_pulse_inv_po}">{$p.po_no}</a></td><td>{$p.supplier}</td><td class="text-right">{$cur}{$p.total|number_format:0}</td><td>{$p.expected_date}</td><td>{$p.status|replace:'_':' '}</td></tr>{/foreach}</tbody></table>
<h4>New purchase order</h4><form method="post"><div class="form-inline"><select name="id_supplier" class="form-control">{foreach $suppliers as $s}<option value="{$s.id_pulse_inv_supplier}">{$s.name}</option>{/foreach}</select> <input name="po_request" class="form-control" placeholder="from requisition id" style="width:150px" value="{if isset($req) && $req.type=='purchase'}{$req.id_pulse_inv_request}{/if}"> <input type="date" name="expected_date" class="form-control"> <input name="pnote" class="form-control" placeholder="Note"></div><table class="table table-condensed"><thead><tr><th>Item</th><th>Qty (purchase units)</th><th>Unit price (blank = last)</th><th>Tax %</th></tr></thead>{if isset($req_lines) && isset($req) && $req.type=='purchase'}{foreach $req_lines as $l}<tr><td><select name="p_id[]" class="form-control input-sm">{foreach $items as $i}<option value="{$i.id_pulse_inv_item}" {if $i.id_pulse_inv_item==$l.id_pulse_inv_item}selected{/if}>{$i.name}</option>{/foreach}</select></td><td><input name="p_qty[]" class="form-control input-sm" value="{$l.qty_approved|default:$l.qty_requested}"></td><td><input name="p_price[]" class="form-control input-sm"></td><td><input name="p_tax[]" class="form-control input-sm" value="7.5"></td></tr>{/foreach}{/if}{section name=n loop=4}<tr><td><select name="p_id[]" class="form-control input-sm"><option value="">—</option>{foreach $items as $i}<option value="{$i.id_pulse_inv_item}">{$i.name} ({$i.purchase_unit|default:$i.unit})</option>{/foreach}</select></td><td><input name="p_qty[]" class="form-control input-sm"></td><td><input name="p_price[]" class="form-control input-sm"></td><td><input name="p_tax[]" class="form-control input-sm" value="7.5"></td></tr>{/section}</table><button name="createPo" class="btn btn-default">Create PO (draft)</button></form></div>
<div class="panel" id="grn"><h3>Goods received (GRN)</h3><table class="table table-condensed"><tbody>{foreach $grns as $g}<tr><td>{$g.grn_no}</td><td>{$g.supplier}</td><td>{$g.store}</td><td>{$g.invoice_no}</td><td class="text-right">{$cur}{$g.total|number_format:0}</td><td>{$g.status}</td><td>{$g.business_date}</td></tr>{/foreach}</tbody></table>
<form method="post"><div class="form-inline"><select name="id_supplier" class="form-control">{foreach $suppliers as $s}<option value="{$s.id_pulse_inv_supplier}" {if isset($po) && $po.id_pulse_inv_supplier==$s.id_pulse_inv_supplier}selected{/if}>{$s.name}</option>{/foreach}</select> <select name="id_store" class="form-control">{foreach $stores as $s}<option value="{$s.id_pulse_inv_store}" {if $s.code=='MAIN'}selected{/if}>into {$s.code}</option>{/foreach}</select> <input name="grn_po" class="form-control" placeholder="PO id" style="width:90px" value="{if isset($po)}{$po.id_pulse_inv_po}{/if}"> <select name="gdept" class="form-control">{foreach ['general','fnb','housekeeping','rooms','admin','maintenance'] as $d}<option>{$d}</option>{/foreach}</select></div><div class="form-inline" style="margin-top:4px"><input name="invoice_no" class="form-control" placeholder="Supplier invoice no."> <input type="date" name="invoice_date" class="form-control"> <input name="invoice_total" class="form-control" placeholder="Invoice total" style="width:120px"> <input name="gnote" class="form-control" placeholder="Note"></div>
<table class="table table-condensed"><thead><tr><th>Item</th><th>Qty recv</th><th>Unit price</th><th>Tax%</th><th>Batch</th><th>Expiry</th><th>Rejected</th></tr></thead>{if isset($po)}{foreach $po.lines as $l}<tr><td><select name="g_id[]" class="form-control input-sm">{foreach $items as $i}<option value="{$i.id_pulse_inv_item}" {if $i.id_pulse_inv_item==$l.id_pulse_inv_item}selected{/if}>{$i.name}</option>{/foreach}</select></td><td><input name="g_qty[]" class="form-control input-sm" value="{$l.qty_ordered-$l.qty_received}"></td><td><input name="g_price[]" class="form-control input-sm" value="{$l.unit_price}"></td><td><input name="g_tax[]" class="form-control input-sm" value="{$l.tax_pct}"></td><td><input name="g_batch[]" class="form-control input-sm"></td><td><input type="date" name="g_exp[]" class="form-control input-sm"></td><td><input name="g_rej[]" class="form-control input-sm" value="0" style="width:60px"></td></tr>{/foreach}{/if}{section name=n loop=4}<tr><td><select name="g_id[]" class="form-control input-sm"><option value="">—</option>{foreach $items as $i}<option value="{$i.id_pulse_inv_item}">{$i.name} ({$i.purchase_unit|default:$i.unit})</option>{/foreach}</select></td><td><input name="g_qty[]" class="form-control input-sm"></td><td><input name="g_price[]" class="form-control input-sm"></td><td><input name="g_tax[]" class="form-control input-sm" value="7.5"></td><td><input name="g_batch[]" class="form-control input-sm"></td><td><input type="date" name="g_exp[]" class="form-control input-sm"></td><td><input name="g_rej[]" class="form-control input-sm" value="0" style="width:60px"></td></tr>{/section}</table><button name="receive" class="btn btn-primary">Receive goods</button> <small class="help-block">Prices are per purchase unit; stock is converted to stock units using the item's purchase factor. Accepted value goes to the expense ledger under the category's expense code.</small></form></div></div></div></div>
