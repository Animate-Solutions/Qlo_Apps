<div class="pulse-inv"><div class="panel"><h3><i class="icon-archive"></i> Inventory &amp; Stores <span class="pull-right"><a class="btn btn-default btn-sm" href="{$links.pur}">Purchasing ({$open_requests} open)</a> <a class="btn btn-default btn-sm" href="{$links.cnt}">Counts ({$open_counts})</a> <a class="btn btn-default btn-sm" href="{$links.mb}">Minibar &amp; amenities</a> <a class="btn btn-default btn-sm" href="{$links.rep}">Reports</a> <a class="btn btn-default btn-sm" href="{$links.set}">Items &amp; suppliers</a></span></h3>
<div class="row kpis"><div class="col-md-3"><span>{$cur}{$total_value|number_format:0}</span>Stock value (all stores)</div><div class="col-md-3"><span>{$reorder|count}</span>Items below reorder</div><div class="col-md-3"><span>{$expiring|count}</span>Batches expiring soon</div><div class="col-md-3"><span>{$stock|count}</span>Active items</div></div>
<form method="get" class="form-inline"><input type="hidden" name="controller" value="AdminPulseInventory"><input type="hidden" name="token" value="{$smarty.get.token|escape}"><select name="store" class="form-control"><option value="">all stores</option>{foreach $stores as $s}<option value="{$s.id_pulse_inv_store}" {if $store==$s.id_pulse_inv_store}selected{/if}>{$s.name}</option>{/foreach}</select> <select name="cat" class="form-control"><option value="">all categories</option>{foreach $categories as $c}<option value="{$c.id_pulse_inv_category}" {if $cat==$c.id_pulse_inv_category}selected{/if}>{$c.name}</option>{/foreach}</select> <label><input type="checkbox" name="low" value="1" {if $low}checked{/if}> below reorder only</label> <button class="btn btn-default">Filter</button></form>
<table class="table table-condensed"><thead><tr><th>SKU</th><th>Item</th><th>Category</th><th class="text-right">On hand</th><th>By store</th><th class="text-right">Avg cost</th><th class="text-right">Value</th><th>Reorder at</th><th>Supplier</th><th>Link</th></tr></thead><tbody>{foreach $stock as $i}<tr class="{if $i.qty<=$i.reorder_level}warning{/if}"><td>{$i.sku}</td><td>{$i.name}</td><td>{$i.category}</td><td class="text-right">{$i.qty} {$i.unit}</td><td><small>{$i.by_store}</small></td><td class="text-right">{$i.avg_cost|number_format:2}</td><td class="text-right">{$i.value|number_format:0}</td><td>{$i.reorder_level}</td><td>{$i.supplier}</td><td><small>{$i.link_type|replace:'_':' '}</small></td></tr>{/foreach}</tbody></table></div>
<div class="row"><div class="col-md-6"><div class="panel"><h3>Issue / consume / waste / return</h3><form method="post" class="form-inline"><select name="id_item" class="form-control">{foreach $stock as $i}<option value="{$i.id_pulse_inv_item}">{$i.name} ({$i.unit})</option>{/foreach}</select> <select name="id_store" class="form-control">{foreach $stores as $s}<option value="{$s.id_pulse_inv_store}">{$s.code}</option>{/foreach}</select> <select name="mtype" class="form-control">{foreach $types as $t}<option>{$t}</option>{/foreach}</select> <input name="qty" class="form-control" placeholder="qty" style="width:80px"> <select name="department" class="form-control"><option value="">dept</option>{foreach ['fnb','housekeeping','rooms','admin','maintenance','laundry','general'] as $d}<option>{$d}</option>{/foreach}</select> <input name="reason" class="form-control" placeholder="reason / cost centre"> <input name="reference" class="form-control" placeholder="ref" style="width:90px"> <button name="quickMove" class="btn btn-default">Post</button></form>
<h4>Transfer between stores</h4><form method="post" class="form-inline"><select name="id_item" class="form-control">{foreach $stock as $i}<option value="{$i.id_pulse_inv_item}">{$i.name}</option>{/foreach}</select> <select name="from_store" class="form-control">{foreach $stores as $s}<option value="{$s.id_pulse_inv_store}">{$s.code}</option>{/foreach}</select> → <select name="to_store" class="form-control">{foreach $stores as $s}<option value="{$s.id_pulse_inv_store}">{$s.code}</option>{/foreach}</select> <input name="qty" class="form-control" placeholder="qty" style="width:80px"> <input name="reason" class="form-control" placeholder="reason"> <button name="transfer" class="btn btn-default">Transfer</button></form>
<form method="post" style="margin-top:8px"><button name="importLinked" class="btn btn-default btn-sm">Import / link POS ingredients &amp; Maintenance parts</button> <small class="help-block">Linked items are the master here; POS recipe deductions and work-order part issues flow in automatically, and receipts here update the POS and Maintenance quantities.</small></form></div>
<div class="panel"><h3>Valuation by group &amp; store</h3><table class="table table-condensed"><tbody>{foreach $valuation as $v}<tr><td>{$v.group_name|replace:'_':' '}</td><td>{$v.store}</td><td>{$v.items} items</td><td class="text-right">{$cur}{$v.value|number_format:0}</td></tr>{/foreach}</tbody></table></div></div>
<div class="col-md-6">{if $reorder}<div class="panel"><h3 class="text-warning">Below reorder level</h3><table class="table table-condensed"><thead><tr><th>Item</th><th>On hand</th><th>On order</th><th>Suggest</th></tr></thead><tbody>{foreach $reorder as $r}<tr><td>{$r.name}</td><td>{$r.qty} {$r.unit}</td><td>{$r.on_order}</td><td>{$r.suggest_purchase_units} {$r.purchase_unit|default:$r.unit}</td></tr>{/foreach}</tbody></table><a class="btn btn-default btn-sm" href="{$links.pur}">Raise purchase requisition</a></div>{/if}
{if $expiring}<div class="panel"><h3 class="text-danger">Expiring batches</h3><table class="table table-condensed"><tbody>{foreach $expiring as $b}<tr><td>{$b.name}</td><td>{$b.store}</td><td>{$b.batch_no}</td><td>{$b.qty} {$b.unit}</td><td>{$b.expiry}</td></tr>{/foreach}</tbody></table></div>{/if}
<div class="panel"><h3>Movements {$from} → {$to}</h3><form method="get" class="form-inline"><input type="hidden" name="controller" value="AdminPulseInventory"><input type="hidden" name="token" value="{$smarty.get.token|escape}"><input type="date" name="from" value="{$from}" class="form-control input-sm"> <input type="date" name="to" value="{$to}" class="form-control input-sm"> <button class="btn btn-sm btn-default">Show</button></form><table class="table table-condensed"><tbody>{foreach $movements as $m}<tr><td>{$m.date_add|date_format:"%d/%m %H:%M"}</td><td>{$m.store}</td><td>{$m.name}</td><td>{$m.type|replace:'_':' '}</td><td class="text-right">{$m.qty}</td><td class="text-right">{$m.value|number_format:0}</td><td><small>{$m.reference} {$m.reason}</small></td><td><small>{$m.who}</small></td></tr>{/foreach}</tbody></table></div></div></div></div>
