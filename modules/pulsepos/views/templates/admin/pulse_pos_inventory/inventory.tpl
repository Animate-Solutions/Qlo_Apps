<div class="pulse-pos">{if $inv_master}<div class="alert alert-info"><strong>Pulse Inventory &amp; Stores is installed and is the stock master.</strong> Receive F&amp;B purchases and do stock counts there; quantities and costs here are updated automatically from the Kitchen and Bar stores. Recipe deductions and waste recorded here flow back to Inventory.</div>{/if}<div class="row"><div class="col-md-8"><div class="panel"><h3><i class="icon-archive"></i> Ingredients &amp; stock</h3>
<form method="post"><table class="table table-condensed"><thead><tr><th>SKU</th><th>Ingredient</th><th>Group</th><th>On hand</th><th>Reorder</th><th>Unit cost</th><th>Value</th><th>Supplier</th><th>Stock take</th></tr></thead><tbody>{foreach $ingredients as $i}<tr class="{if $i.qty_on_hand<=$i.reorder_level}warning{/if}"><td>{$i.sku}</td><td>{$i.name}</td><td>{$i.group_name}</td><td>{$i.qty_on_hand} {$i.unit}</td><td>{$i.reorder_level}</td><td>{$i.unit_cost}</td><td>{$i.value|number_format:0}</td><td>{$i.supplier}</td><td><input name="cnt[{$i.id_pulse_pos_ingredient}]" class="input-xs" style="width:70px" placeholder="count"></td></tr>{/foreach}</tbody></table><button name="count" class="btn btn-default btn-sm" onclick="return confirm('Apply counted quantities?')">Apply stock take</button></form>
<h4>Add / edit ingredient</h4><form method="post" class="form-inline"><input type="hidden" name="id_ing"><input name="sku" class="form-control" placeholder="SKU" required> <input name="name" class="form-control" placeholder="Name" required> <select name="group_name" class="form-control"><option>food</option><option>beverage</option><option>liquor</option><option>consumable</option></select> <input name="unit" class="form-control" placeholder="kg/l/pc/tot" style="width:80px"> <input name="reorder_level" class="form-control" placeholder="reorder" style="width:80px"> <input name="unit_cost" class="form-control" placeholder="unit cost" style="width:100px"> <input name="supplier" class="form-control" placeholder="Supplier"> <button name="saveIngredient" class="btn btn-default">Save</button></form></div>
<div class="panel"><h3>Receive purchase (feeds the expense ledger as Food / Beverage purchases)</h3><form method="post"><div class="form-inline"><input name="supplier" class="form-control" placeholder="Supplier" required> <input name="invoice" class="form-control" placeholder="Invoice ref"></div><table class="table table-condensed">{section name=n loop=6}<tr><td><select name="p_ing[]" class="form-control input-sm"><option value="">—</option>{foreach $ingredients as $i}<option value="{$i.id_pulse_pos_ingredient}">{$i.name} ({$i.unit})</option>{/foreach}</select></td><td><input name="p_qty[]" class="form-control input-sm" placeholder="qty"></td><td><input name="p_cost[]" class="form-control input-sm" placeholder="unit cost"></td></tr>{/section}</table><button name="purchase" class="btn btn-primary">Receive</button></form></div>
<div class="panel"><h3>Requisitions &amp; store transfers (central store → outlet)</h3><table class="table table-condensed"><thead><tr><th>Req</th><th>From → To</th><th>Lines</th><th>Status</th><th>By</th><th></th></tr></thead><tbody>{foreach $requisitions as $r}<tr><td>{$r.req_no}</td><td>{$r.from_store} → {$r.to_store}</td><td><small>{$r.lines|truncate:80}</small></td><td>{$r.status}</td><td>{$r.who}</td><td>{if $r.status!='issued'}<form method="post" class="inline"><input type="hidden" name="id_req" value="{$r.id_pulse_pos_requisition}"><button name="issueReq" class="btn btn-xs btn-default">Issue in full</button></form>{/if}</td></tr>{/foreach}</tbody></table><form method="post"><div class="form-inline">from <input name="q_from" class="form-control" value="main" style="width:90px"> to <select name="q_to" class="form-control">{foreach $stores as $s}<option>{$s.store}</option>{/foreach}</select> <input name="q_note" class="form-control" placeholder="Note"></div><table class="table table-condensed">{section name=n loop=4}<tr><td><select name="q_ing[]" class="form-control input-sm"><option value="">—</option>{foreach $ingredients as $i}<option value="{$i.id_pulse_pos_ingredient}">{$i.name} ({$i.unit})</option>{/foreach}</select></td><td><input name="q_qty[]" class="form-control input-sm" placeholder="qty"></td></tr>{/section}</table><button name="requisition" class="btn btn-default btn-sm">Raise requisition</button></form>{if $store_stock}<h4>Stock by store</h4><table class="table table-condensed"><tbody>{foreach $store_stock as $s}<tr><td>{$s.store}</td><td>{$s.name}</td><td>{$s.qty_on_hand} {$s.unit}</td></tr>{/foreach}</tbody></table>{/if}</div>
<div class="panel"><h3>Variance — theoretical vs actual {$from} → {$to}</h3><table class="table table-condensed"><thead><tr><th>Ingredient</th><th>Opening count</th><th>+ Purchased</th><th>− Recipe usage</th><th>− Waste</th><th>= Expected</th><th>Actual</th><th>Variance</th><th>Value</th></tr></thead><tbody>{foreach $variance as $v}<tr class="{if $v.variance!==null && $v.variance<0}danger{/if}"><td>{$v.name} <small>{$v.unit}</small></td><td>{$v.opening_count|default:'—'}</td><td>{$v.purchased}</td><td>{$v.theoretical_usage}</td><td>{$v.waste}</td><td>{$v.expected|default:'—'}</td><td>{$v.actual}</td><td>{$v.variance|default:'—'}</td><td>{$v.variance_value|default:'—'}</td></tr>{/foreach}</tbody></table><p class="help-block">Requires a stock count before the period start. Negative variance = shrinkage (over-pouring, theft, unrecorded waste).</p></div></div>
<div class="col-md-4"><div class="panel"><h3>Waste / spoilage</h3><form method="post" class="form-inline"><select name="w_ing" class="form-control">{foreach $ingredients as $i}<option value="{$i.id_pulse_pos_ingredient}">{$i.name}</option>{/foreach}</select> <input name="w_qty" class="form-control" placeholder="qty" style="width:70px"> <select name="w_reason" class="form-control">{foreach $waste_reasons as $r}<option>{$r.name}</option>{/foreach}</select> <button name="waste" class="btn btn-default">Record</button></form></div>
<div class="panel"><h3>Cost of sales {$from} → {$to}</h3><form method="get" class="form-inline"><input type="hidden" name="controller" value="AdminPulsePosInventory"><input type="hidden" name="token" value="{$smarty.get.token|escape}"><input type="date" name="from" value="{$from}" class="form-control input-sm"> <input type="date" name="to" value="{$to}" class="form-control input-sm"> <button class="btn btn-sm btn-default">Run</button></form><table class="table table-condensed"><tbody>{foreach $cogs as $c}<tr><td>{$c.group_name}</td><td class="text-right">{$c.cost|number_format:0}</td></tr>{/foreach}</tbody></table>
<h4>Waste</h4><table class="table table-condensed"><tbody>{foreach $waste as $w}<tr><td>{$w.name}</td><td>{$w.qty} {$w.unit}</td><td class="text-right">{$w.value|number_format:0}</td><td><small>{$w.reasons}</small></td></tr>{/foreach}</tbody></table></div>
<div class="panel"><h3>Purchases</h3><table class="table table-condensed"><tbody>{foreach $purchases as $p}<tr><td>{$p.purchase_no}</td><td>{$p.supplier}</td><td>{$p.invoice_ref}</td><td class="text-right">{$p.total|number_format:0}</td><td>{$p.business_date}</td></tr>{/foreach}</tbody></table></div>
<div class="panel"><h3>Recent movements</h3><table class="table table-condensed"><tbody>{foreach $moves as $m}<tr><td>{$m.date_add|date_format:"%d/%m %H:%M"}</td><td>{$m.name}</td><td>{$m.type}</td><td>{$m.qty}</td><td><small>{$m.reason} {$m.reference}</small></td></tr>{/foreach}</tbody></table></div></div></div></div>
