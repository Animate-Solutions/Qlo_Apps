<div class="pulse-pos"><div class="panel"><h3>Terminals</h3><p>POS terminal: <a href="{$pos_url}" target="_blank">{$pos_url}</a> (add to the tablet home screen) · Kitchen display: <a href="{$kds_url}" target="_blank">{$kds_url}</a>?station=KITCHEN (needs an API token with scope <code>kds</code> from the Pulse hub)</p></div>
<div class="row"><div class="col-md-6"><div class="panel"><h3>Outlets / revenue centres</h3><table class="table table-condensed"><thead><tr><th>Code</th><th>Name</th><th>Type</th><th>SC%</th><th>Tax</th><th>Room chg</th><th>Tabs</th><th>Covers</th></tr></thead><tbody>{foreach $outlets as $o}<tr><td>{$o.code}</td><td>{$o.name}</td><td>{$o.type}</td><td>{$o.service_charge_pct}</td><td>{$o.tax_group}</td><td>{$o.allow_room_charge}</td><td>{$o.allow_tabs}</td><td>{$o.require_covers}</td></tr>{/foreach}</tbody></table>
<form method="post" class="form-inline"><input type="hidden" name="id_outlet"><input name="code" class="form-control" placeholder="CODE" style="width:80px" required> <input name="name" class="form-control" placeholder="Name" required> <select name="type" class="form-control"><option>restaurant</option><option>bar</option><option>room_service</option><option>pool</option><option>banquet</option><option>takeaway</option><option>lounge</option></select> SC% <input name="service_charge_pct" class="form-control" value="10" style="width:60px"> <label><input type="checkbox" name="sc_taxable" value="1"> SC taxable</label> <select name="id_tax_group" class="form-control">{foreach $tax_groups as $t}<option value="{$t.id_pulse_pos_tax_group}">{$t.name}</option>{/foreach}</select><br><label><input type="checkbox" name="allow_room_charge" value="1" checked> room charge</label> <label><input type="checkbox" name="allow_tabs" value="1" checked> bar tabs</label> <label><input type="checkbox" name="require_covers" value="1" checked> ask covers</label> tray <input name="tray_charge" class="form-control" value="0" style="width:80px"> <label><input type="checkbox" name="speed_screen" value="1"> speed screen</label> store <input name="store" class="form-control" value="main" style="width:80px"> <input name="receipt_header" class="form-control" placeholder="Receipt header"> <input name="receipt_footer" class="form-control" placeholder="Receipt footer"> <button name="saveOutlet" class="btn btn-default">Save outlet</button></form>
<h4>Sections</h4>{foreach $sections as $s}<span class="label label-default">{$s.outlet}: {$s.name}</span> {/foreach}<form method="post" class="form-inline" style="margin-top:6px"><select name="s_outlet" class="form-control">{foreach $outlets as $o}<option value="{$o.id_pulse_pos_outlet}">{$o.name}</option>{/foreach}</select> <input name="sname" class="form-control" placeholder="Section"> <input name="ssort" class="form-control" placeholder="sort" style="width:60px"> <button name="saveSection" class="btn btn-default btn-sm">Add</button></form></div>
<div class="panel"><h3>Tables</h3><table class="table table-condensed"><thead><tr><th>Outlet</th><th>Section</th><th>Code</th><th>Seats</th><th>Shape</th><th>X,Y</th><th>Status</th></tr></thead><tbody>{foreach $tables as $t}<tr><td>{$t.outlet}</td><td>{$t.section}</td><td>{$t.code}</td><td>{$t.seats}</td><td>{$t.shape}</td><td>{$t.pos_x},{$t.pos_y}</td><td>{$t.status}</td></tr>{/foreach}</tbody></table>
<form method="post" class="form-inline"><input type="hidden" name="id_table"><select name="t_outlet" class="form-control">{foreach $outlets as $o}<option value="{$o.id_pulse_pos_outlet}">{$o.name}</option>{/foreach}</select> <select name="t_section" class="form-control"><option value="">—</option>{foreach $sections as $s}<option value="{$s.id_pulse_pos_section}">{$s.name}</option>{/foreach}</select> <input name="tcode" class="form-control" placeholder="T1" style="width:70px"> <input name="seats" class="form-control" value="4" style="width:60px"> <select name="shape" class="form-control"><option>square</option><option>round</option><option>rect</option><option>bar</option></select> x <input name="pos_x" class="form-control" value="40" style="width:60px"> y <input name="pos_y" class="form-control" value="40" style="width:60px"> <button name="saveTable" class="btn btn-default btn-sm">Save table</button></form>
<form method="post" class="form-inline" style="margin-top:6px">Bulk: <select name="b_outlet" class="form-control">{foreach $outlets as $o}<option value="{$o.id_pulse_pos_outlet}">{$o.name}</option>{/foreach}</select> <select name="b_section" class="form-control"><option value="">—</option>{foreach $sections as $s}<option value="{$s.id_pulse_pos_section}">{$s.name}</option>{/foreach}</select> <input name="b_prefix" class="form-control" value="T" style="width:50px"><input name="b_count" class="form-control" placeholder="count" style="width:70px"><input name="b_seats" class="form-control" value="4" style="width:60px"> <button name="bulkTables" class="btn btn-default btn-sm">Create</button></form></div></div>
<div class="col-md-6"><div class="panel"><h3>POS users &amp; PINs</h3><table class="table table-condensed"><thead><tr><th>Name</th><th>Role</th><th>Void sent</th><th>Discount</th><th>Max %</th><th>Reopen</th><th>Comp</th><th>Settle</th><th>Outlets</th><th>Active</th></tr></thead><tbody>{foreach $staff as $s}<tr><td>{$s.name}</td><td>{$s.role}</td><td>{$s.can_void_sent}</td><td>{$s.can_discount}</td><td>{$s.max_discount_pct}</td><td>{$s.can_reopen}</td><td>{$s.can_comp}</td><td>{$s.can_settle}</td><td>{$s.outlets|default:'all'}</td><td>{$s.active}</td></tr>{/foreach}</tbody></table>
<form method="post" class="form-inline"><select name="id_employee" class="form-control">{foreach $employees as $e}<option value="{$e.id_employee}">{$e.firstname} {$e.lastname}</option>{/foreach}</select> <input name="pin" class="form-control" placeholder="PIN (4–6 digits)" style="width:130px"> <select name="role" class="form-control"><option>waiter</option><option>cashier</option><option>bartender</option><option>supervisor</option><option>manager</option><option>kitchen</option></select><br><label><input type="checkbox" name="can_void_sent" value="1"> void sent</label> <label><input type="checkbox" name="can_discount" value="1"> discount</label> max% <input name="max_discount_pct" class="form-control" value="0" style="width:60px"> <label><input type="checkbox" name="can_reopen" value="1"> reopen</label> <label><input type="checkbox" name="can_comp" value="1"> comp</label> <label><input type="checkbox" name="can_settle" value="1" checked> settle</label> outlets: {foreach $outlets as $o}<label class="checkbox-inline"><input type="checkbox" name="st_outlets[]" value="{$o.id_pulse_pos_outlet}"> {$o.code}</label>{/foreach} <button name="saveStaff" class="btn btn-default">Save user</button></form><p class="help-block">Default after install: the first back-office employee has manager PIN <strong>1234</strong> — change it before go-live.</p></div>
<div class="panel"><h3>Prep stations &amp; printers</h3><table class="table table-condensed"><thead><tr><th>Code</th><th>Station</th><th>Printer</th><th>KDS</th><th></th></tr></thead><tbody>{foreach $stations as $s}<tr><td>{$s.code}</td><td>{$s.name}</td><td>{$s.printer_host}{if $s.printer_host}:{$s.printer_port}{/if}</td><td>{$s.kds}</td><td>{if $s.printer_host}<form method="post" class="inline"><input type="hidden" name="id_station_t" value="{$s.id_pulse_pos_station}"><button name="testPrint" class="btn btn-xs btn-default">Test print</button></form>{/if}</td></tr>{/foreach}</tbody></table>
<form method="post" class="form-inline"><input type="hidden" name="id_station"><input name="scode" class="form-control" placeholder="CODE" style="width:90px"> <input name="stname" class="form-control" placeholder="Name"> <input name="printer_host" class="form-control" placeholder="Printer IP"> <input name="printer_port" class="form-control" value="9100" style="width:70px"> <label><input type="checkbox" name="kds" value="1" checked> on KDS</label> <button name="saveStation" class="btn btn-default">Save</button></form></div>
<div class="panel"><h3>Tax groups</h3>{foreach $tax_groups as $t}<span class="label label-default">{$t.name} {$t.rate_pct}%</span> {/foreach}<form method="post" class="form-inline" style="margin-top:6px"><input name="txname" class="form-control" placeholder="Name"> <input name="rate_pct" class="form-control" placeholder="total %" style="width:80px"> <input name="components" class="form-control" placeholder="VAT 7.5|Consumption 5"> <button name="saveTax" class="btn btn-default btn-sm">Add</button></form></div>
<div class="panel"><h3>Gift / meal vouchers</h3><table class="table table-condensed"><tbody>{foreach $vouchers as $v}<tr><td><code>{$v.code}</code></td><td>{$v.type}</td><td>{$v.value}</td><td>bal {$v.balance}</td><td>{$v.issued_to}</td><td>{$v.expires}</td></tr>{/foreach}</tbody></table><form method="post" class="form-inline"><input name="vprefix" class="form-control" value="GV" style="width:60px"> <select name="vtype" class="form-control"><option>gift</option><option>meal</option><option>promo</option></select> <input name="vvalue" class="form-control" placeholder="value" style="width:90px"> <input name="vcount" class="form-control" value="1" style="width:60px"> <input name="vto" class="form-control" placeholder="Issued to"> <input type="date" name="vexp" class="form-control"> <button name="saveVoucher" class="btn btn-default btn-sm">Create</button></form></div></div></div></div>
