<div class="pulse-pos"><div class="panel"><h3><i class="icon-bar-chart"></i> POS reports</h3>
<form method="get" class="form-inline"><input type="hidden" name="controller" value="AdminPulsePosReports"><input type="hidden" name="token" value="{$smarty.get.token|escape}"><select name="report" class="form-control">{foreach $reports as $k=>$v}<option value="{$k}" {if $k==$report}selected{/if}>{$v}</option>{/foreach}</select> <select name="outlet" class="form-control"><option value="">all outlets</option>{foreach $outlets as $o}<option value="{$o.id_pulse_pos_outlet}" {if $outlet==$o.id_pulse_pos_outlet}selected{/if}>{$o.name}</option>{/foreach}</select> <input type="date" name="from" value="{$from}" class="form-control"> <input type="date" name="to" value="{$to}" class="form-control"> <button class="btn btn-default">Run</button> <button name="export" value="1" class="btn btn-default"><i class="icon-download"></i> CSV</button></form>
<h4>{$reports[$report]} · {$from} → {$to}</h4><table class="table table-striped table-condensed"><thead><tr>{foreach $columns as $c}<th>{$c|replace:'_':' '}</th>{/foreach}</tr></thead><tbody>{foreach $rows as $r}<tr>{foreach $r as $v}<td>{$v}</td>{/foreach}</tr>{foreachelse}<tr><td colspan="{$columns|count|max:1}"><em>No data</em></td></tr>{/foreach}</tbody></table>
{if $report=='engineering'}<p class="help-block">Star = popular &amp; profitable (keep, feature). Plowhorse = popular, low margin (raise price / cut cost). Puzzle = profitable, unpopular (promote, reposition). Dog = neither (remove).</p>{/if}</div></div>
