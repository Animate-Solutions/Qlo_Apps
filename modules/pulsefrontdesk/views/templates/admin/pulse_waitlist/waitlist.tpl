<div class="pulse-fd"><div class="row"><div class="col-md-8"><div class="panel"><h3><i class="icon-time"></i> Waitlist <form method="post" class="pull-right"><button name="runOffers" class="btn btn-default btn-sm">Check availability &amp; send offers</button></form></h3>
<form method="post" class="form-inline" style="margin-bottom:10px"><input name="guest_name" class="form-control" placeholder="Guest name" required> <input name="phone" class="form-control" placeholder="Phone"> <input name="email" class="form-control" placeholder="Email"> <select name="id_product" class="form-control">{foreach $types as $t}<option value="{$t.id_product}">{$t.name}</option>{/foreach}</select> <input type="date" name="date_from" class="form-control" required> <input type="date" name="date_to" class="form-control" required> <input name="rooms" type="number" value="1" class="form-control" style="width:60px"> <select name="priority" class="form-control"><option value="1">P1 VIP</option><option value="3">P3 repeat</option><option value="5" selected>P5</option></select> <input name="note" class="form-control" placeholder="Note"> <button name="addWait" class="btn btn-default">Add</button></form>
<table class="table"><thead><tr><th>P</th><th>Guest</th><th>Contact</th><th>Type</th><th>Dates</th><th>Rooms</th><th>Status</th><th></th></tr></thead><tbody>
{foreach $queue as $w}<tr class="{if $w.status=='offered'}success{/if}"><td>{$w.priority}</td><td>{$w.guest_name}</td><td><small>{$w.phone} {$w.email}</small></td><td>{$w.room_type}</td><td>{$w.date_from} → {$w.date_to}</td><td>{$w.rooms}</td><td>{$w.status}{if $w.offered_at}<br><small>offered {$w.offered_at}</small>{/if}</td>
<td><form method="post" class="inline"><input type="hidden" name="id" value="{$w.id_pulse_waitlist}"><button name="convert" class="btn btn-xs btn-success">Book now</button> <button name="cancelWait" class="btn btn-xs btn-default">Cancel</button></form></td></tr>{foreachelse}<tr><td colspan="8"><em>Waitlist empty</em></td></tr>{/foreach}</tbody></table>
<h4>History</h4><table class="table table-condensed"><tbody>{foreach $done as $w}<tr><td>{$w.guest_name}</td><td>{$w.room_type}</td><td>{$w.date_from} → {$w.date_to}</td><td>{$w.status}</td></tr>{/foreach}</tbody></table></div></div>
<div class="col-md-4"><div class="panel"><h3>Overbooking allowance</h3><form method="post"><table class="table table-condensed"><thead><tr><th>Room type</th><th>Max rooms over</th></tr></thead><tbody>{foreach $types as $t}<tr><td>{$t.name}</td><td><input name="max_over[{$t.id_product}]" type="number" min="0" max="5" value="{$t.max_over}" class="form-control input-sm" style="width:70px"></td></tr>{/foreach}</tbody></table><button name="saveOver" class="btn btn-default">Save</button></form>
<p class="help-block">Desk reservations may exceed physical rooms by this many per type (walk-in and phone only; QloApps online booking is never overbooked). Night audit flags unresolved overbookings as alerts.</p></div></div></div></div>
