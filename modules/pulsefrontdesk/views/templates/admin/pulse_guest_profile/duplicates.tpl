<div class="pulse-fd"><div class="panel"><h3>Possible duplicate profiles <a class="btn btn-default btn-sm pull-right" href="{$self_url}">Back</a></h3>
<table class="table"><thead><tr><th>Match</th><th>Profile A</th><th>Profile B</th><th></th></tr></thead><tbody>
{foreach $dups as $d}<tr><td><span class="label label-default">{$d.reason}</span></td><td>#{$d.a} {$d.name_a}<br><small>{$d.email_a}</small></td><td>#{$d.b} {$d.name_b}<br><small>{$d.email_b}</small></td>
<td><form method="post" class="inline"><input type="hidden" name="keep" value="{$d.a}"><input type="hidden" name="merge" value="{$d.b}"><button name="mergeProfiles" class="btn btn-xs btn-default" onclick="return confirm('Merge B into A? B will be deactivated.')">Keep A</button></form> <form method="post" class="inline"><input type="hidden" name="keep" value="{$d.b}"><input type="hidden" name="merge" value="{$d.a}"><button name="mergeProfiles" class="btn btn-xs btn-default" onclick="return confirm('Merge A into B?')">Keep B</button></form></td></tr>{foreachelse}<tr><td colspan="4"><em>No duplicates found</em></td></tr>{/foreach}</tbody></table>
<p class="help-block">Merging repoints bookings, orders, folios, ID documents and tickets to the kept profile, sums stay statistics and deactivates the other customer record.</p></div></div>
