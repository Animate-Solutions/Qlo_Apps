<div class="pulse-fd"><div class="panel"><h3>City ledger ageing <a class="btn btn-default btn-sm pull-right" href="{$self_url}">Back</a></h3>
<table class="table table-striped"><thead><tr><th>Company</th><th class="text-right">Current (0–30)</th><th class="text-right">31–60</th><th class="text-right">61–90</th><th class="text-right">90+</th><th class="text-right">Total</th><th class="text-right">Limit</th></tr></thead><tbody>
{foreach $rows as $r}<tr class="{if $r.d90_plus>0}danger{elseif $r.d61_90>0}warning{/if}"><td>{$r.company}</td><td class="text-right">{displayPrice price=$r.current}</td><td class="text-right">{displayPrice price=$r.d31_60}</td><td class="text-right">{displayPrice price=$r.d61_90}</td><td class="text-right">{displayPrice price=$r.d90_plus}</td><td class="text-right"><b>{displayPrice price=$r.total}</b></td><td class="text-right">{displayPrice price=$r.credit_limit}</td></tr>{foreachelse}<tr><td colspan="7"><em>Nothing outstanding</em></td></tr>{/foreach}</tbody></table></div></div>
