<div class="pulse-fd"><div class="panel"><h3>{$hotel} &mdash; Statement {$st.statement_no} <span class="pull-right noprint"><a class="btn btn-default btn-sm" href="javascript:window.print()"><i class="icon-print"></i> Print / PDF</a> <a class="btn btn-default btn-sm" href="{$self_url}">Back</a></span></h3>
<div class="row"><div class="col-md-6"><b>{$st.company->name}</b><br>{$st.company->address}<br>{$st.company->contact_name} · {$st.company->email} · {$st.company->phone}<br>TIN {$st.company->tin}</div><div class="col-md-6 text-right">Period {$st.from} → {$st.to}<br>Account folio {$st.folio->folio_no}<br>Credit limit {displayPrice price=$st.company->credit_limit}</div></div>
<table class="table table-striped"><thead><tr><th>Date</th><th>Description</th><th>Guest / room</th><th class="text-right">Charge</th><th class="text-right">Payment</th><th class="text-right">Balance</th></tr></thead><tbody>
<tr><td colspan="5"><em>Opening balance</em></td><td class="text-right">{displayPrice price=$st.opening}</td></tr>
{foreach $st.lines as $l}<tr><td>{$l.business_date}</td><td>{$l.description}</td><td>{$l.guest} {if $l.room_num}Rm {$l.room_num}{/if}</td><td class="text-right">{if !$l.is_payment}{displayPrice price=$l.amount_tax_incl}{/if}</td><td class="text-right">{if $l.is_payment}{displayPrice price=$l.amount_tax_incl}{/if}</td><td class="text-right">{displayPrice price=$l.running}</td></tr>{/foreach}
<tr><td colspan="5"><b>Closing balance due</b></td><td class="text-right"><b>{displayPrice price=$st.closing}</b></td></tr></tbody></table>
<p>Payment terms: 30 days. Please quote {$st.statement_no} on remittance.</p></div></div>
