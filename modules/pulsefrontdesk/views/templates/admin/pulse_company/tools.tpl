<div class="pulse-fd"><div class="panel"><h3>Accounts receivable</h3><div class="row">
<div class="col-md-5"><form method="get" class="form-inline"><input type="hidden" name="controller" value="AdminPulseCompany"><input type="hidden" name="token" value="{$smarty.get.token|escape}"><select name="statement" class="form-control">{foreach $companies as $c}<option value="{$c.id_pulse_company}">{$c.name}</option>{/foreach}</select> <input type="date" name="from" class="form-control" value="{$smarty.now|date_format:'%Y-%m-01'}"> <input type="date" name="to" class="form-control" value="{$smarty.now|date_format:'%Y-%m-%d'}"> <button class="btn btn-default"><i class="icon-file-text"></i> Statement / invoice</button></form></div>
<div class="col-md-3"><a class="btn btn-default" href="{$self_url}&ageing=1"><i class="icon-bar-chart"></i> Ageing report</a></div>
<div class="col-md-4"><form method="post" class="form-inline"><select name="id_pulse_company" class="form-control">{foreach $companies as $c}<option value="{$c.id_pulse_company}">{$c.name}</option>{/foreach}</select> <select name="department" class="form-control"><option value="*">All charges</option><option value="rooms">Rooms only</option><option value="fnb">F&amp;B only</option></select> <button name="addRule" class="btn btn-default">Auto-route to company</button></form><small class="help-block">Standing routing: charges for this company's guests go straight to the company folio.</small></div>
</div></div></div>
