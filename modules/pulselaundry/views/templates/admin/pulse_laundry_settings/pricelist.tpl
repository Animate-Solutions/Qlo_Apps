<div class="panel"><h3>Price list</h3><table class="table table-condensed"><thead><tr><th>Item</th><th>Category</th><th>Wash</th><th>Dry clean</th><th>Press</th><th>Active</th></tr></thead><tbody>{foreach $items as $i}<tr><td>{$i.name}</td><td>{$i.category}</td><td>{$i.price_wash}</td><td>{$i.price_dryclean}</td><td>{$i.price_press}</td><td>{$i.active}</td></tr>{/foreach}</tbody></table>
<form method="post" class="form-inline"><input type="hidden" name="id_item"><input name="name" class="form-control" placeholder="Item" required> <select name="category" class="form-control"><option>mens</option><option>womens</option><option>kids</option><option>household</option><option>uniform</option></select> <input name="price_wash" class="form-control" placeholder="Wash" style="width:90px"> <input name="price_dryclean" class="form-control" placeholder="Dry clean" style="width:90px"> <input name="price_press" class="form-control" placeholder="Press" style="width:90px"> <button name="saveItem" class="btn btn-default">Save item</button></form></div>
<div class="panel"><h3>Outsourced vendors</h3><table class="table table-condensed"><tbody>{foreach $vendors as $v}<tr><td>{$v.name}</td><td>{$v.contact} {$v.phone}</td><td>{$v.rate_per_kg}/kg</td><td>{$v.turnaround_hours} h</td></tr>{/foreach}</tbody></table>
<form method="post" class="form-inline"><input type="hidden" name="id_vendor"><input name="vname" class="form-control" placeholder="Vendor" required> <input name="vcontact" class="form-control" placeholder="Contact"> <input name="vphone" class="form-control" placeholder="Phone"> <input name="vrate" class="form-control" placeholder="₦/kg" style="width:90px"> <input name="vhours" class="form-control" placeholder="Hours" style="width:80px"> <button name="saveVendor" class="btn btn-default">Save vendor</button></form></div>
