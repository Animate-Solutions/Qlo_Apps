+        ORDER BY TABLE_ROWS DESC LIMIT 10');
+    foreach ((array) $tables as $t) {
+        $out[$t['t']] = (int) Db::getInstance()->getValue('SELECT COUNT(*) FROM `'.bqSQL($t['t']).'`');
+    }
